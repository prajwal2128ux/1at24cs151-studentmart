PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173
MONGO_URI=mongodb://127.0.0.1:27017/studentmart
# Replace with a random secret containing at least 32 characters
JWT_SECRET=replace-this-with-a-long-random-secret-at-least-32-characters
# Used only by `npm run seed:admin`
ADMIN_NAME=StudentMart Administrator
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-strong-password-at-least-12-characters
